# number col (digits)
regexp=\s+(\d+)\s+(?=\s{10,})
colours=yellow
-
# date (MM/DD/YY)
regexp=(\d{2})(\d{2})-(\d{2})-(\d{2})(?=\s+\d{2}:\d{2}:\d{2})
colours=green
replace=\3/\4/\2 
-
# time (HH:MM:SS)
regexp=(\d{2}:\d{2}:\d{2})
colours=bold green
replace=\1 
-
# 'current' keyword
regexp=current
colours=cyan
