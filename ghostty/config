# Font
font-family = Monofoki Nerd Font
font-size = 11
adjust-cell-height = 20%
alpha-blending = linear
cursor-style = bar
adjust-cursor-thickness = 1

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = false
window-inherit-font-size = false
resize-overlay = never
unfocused-split-opacity = 0.6
split-divider-color = #505065

theme = light:iTerm2 Solarized Light,dark:kana

# Behavior
mouse-hide-while-typing = true
shell-integration = zsh
bell-features = no-audio, no-title
notify-on-command-finish = unfocused
confirm-close-surface = true

# Keybindings
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = alt+n=new_split:down
keybind = alt+q=close_surface
keybind = ctrl+tab=toggle_command_palette
keybind = ctrl+down=scroll_to_bottom
keybind = ctrl+up=scroll_to_top
keybind = ctrl+f=start_search

keybind = alt+tab=goto_split:next
keybind = alt+shift+tab=goto_split:previous
keybind = alt+i=goto_split:top
keybind = alt+k=goto_split:bottom

keybind = alt+shift+bracket_right=resize_split:up,100
keybind = alt+shift+bracket_left=resize_split:down,100

keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

keybind = ctrl+enter=unbind
