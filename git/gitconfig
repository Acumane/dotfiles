[core]
    excludesfile = ~/.gitignore

[alias]
    undo = reset --soft HEAD~1
    unstage = restore --staged
    amend = commit --amend
    retcon = commit --amend --no-edit --date
    # restore = restore --staged --worktree
    discard = git clean -fd
    
    tracked = ls-files
    branches = branch -a
    stashes = stash list
    remotes = remote -v
    tags = tag

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
