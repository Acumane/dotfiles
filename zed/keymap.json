[
  {
    "bindings": {
      "alt-f": "file_finder::Toggle",
      "alt-o": "outline::Toggle",
      "alt-c": "command_palette::Toggle",
      "alt-h": "projects::OpenRecent",
      "alt-p": "projects::OpenRecent",
      "alt-n": "workspace::NewFile",
      "ctrl-o": "workspace::Open",
      "ctrl-s": "workspace::Save",
      "alt-e": "project_panel::ToggleFocus",
      "alt-g": "git_panel::ToggleFocus",
      "alt-m": "workspace::ToggleLeftDock",
      "alt-z": "workspace::ToggleCenteredLayout",
      "alt-/": "terminal_panel::Toggle",
      "alt-j": [
        "pane::ActivatePreviousItem",
        {
          "wrap_around": false
        }
      ],
      "alt-l": [
        "pane::ActivateNextItem",
        {
          "wrap_around": false
        }
      ],
      "alt-q": "pane::CloseActiveItem",
      "alt-r": "pane::ReopenClosedItem",
      "shift-alt-j": "pane::SwapItemLeft",
      "shift-alt-l": "pane::SwapItemRight",
      "alt-[": [
        "workspace::DecreaseActiveDockSize",
        {
          "px": 40
        }
      ],
      "alt-]": [
        "workspace::IncreaseActiveDockSize",
        {
          "px": 40
        }
      ],
      "alt-{": [
        "workspace::DecreaseActiveDockSize",
        {
          "px": 40
        }
      ],
      "alt-}": [
        "workspace::IncreaseActiveDockSize",
        {
          "px": 40
        }
      ],
      "alt-s": ["workspace::SendKeystrokes", "ctrl-alt-shift-5 ctrl-alt-right"],
      "ctrl-alt-shift-5": "pane::DeploySearch",
      "alt-tab": "workspace::ActivateNextPane",
      "shift-alt-tab": "workspace::ActivatePreviousPane",
      "alt-w": "git::Worktree",
      "alt-b": "git::Switch",
      "alt-left": "pane::GoBack",
      "alt-right": "pane::GoForward",
      "alt-d": "theme::ToggleMode",
      "alt-a": "agent::Toggle"
    }
  },
  {
    "context": "Pane || Workspace",
    "bindings": {
      "alt-i": "tab_switcher::Toggle",
      "alt-k": "tab_switcher::Toggle"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "j": "vim::Left",
      "k": [
        "vim::Down",
        {
          "display_lines": true
        }
      ],
      "shift-l": "vim::EndOfLine",
      "shift-j": [
        "vim::StartOfLine",
        {
          "display_lines": true
        }
      ],
      "shift-k": "vim::EndOfParagraph",
      "shift-i": "vim::StartOfParagraph",
      "shift-t": "vim::StartOfDocument",
      "shift-b": "vim::EndOfDocument",
      "shift-w": "vim::PreviousWordStart",
      "shift-e": "vim::PreviousWordEnd",
      "o": [
        "vim::Matching",
        {
          "match_quotes": true
        }
      ],
      "u": null,
      "ctrl-u": "vim::Undo",
      "ctrl-p": "vim::Paste",
      "ctrl-v": "vim::Paste",

      "n": "vim::SelectNext",
      "shift-n": null,

      // (g)o: put cursor somewhere
      "g .": "editor::OpenExcerpts",
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToDiagnostic",  // (i)ssues
      "g I": "diagnostics::Deploy",
      "g r": "editor::FindAllReferences",

      // (g)it
      "G s": "git::ToggleStaged",
      "G r": "git::Restore",
      "G b": "git::Blame",
      "G d": "git::OpenFileDiff",
      "G D": "git::Diff",
      "G c": "git::Commit"
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "i": [
        "vim::Up",
        {
          "display_lines": true
        }
      ],
      "d": [
        "workspace::SendKeystrokes",
        "\" _ x"
      ],
      "r": [
        "workspace::SendKeystrokes",
        "\" _ ctrl-alt-c"
      ],
      "f": "vim::HelixJumpToWord"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "h": "vim::InsertBefore",
      "shift-h": "vim::InsertAfter",
      "c": "vim::PushYank",
      "x": "vim::PushDelete",
      "shift-c": "vim::YankLine",
      "shift-x": [
        "workspace::SendKeystrokes",
        "x x"
      ],
      "shift-d": [
        "workspace::SendKeystrokes",
        "\" _ x x"
      ],
      "shift-r": [
        "workspace::SendKeystrokes",
        "\" _ ctrl-alt-c r"
      ],
      "ctrl-alt-c": "vim::PushChange",
      "enter": "vim::InsertLineBelow",
      "shift-enter": "vim::InsertLineAbove",
      "tab": "editor::Indent",
      "shift-tab": "editor::Outdent",
      "space": [
        "workspace::SendKeystrokes",
        "h space escape"
      ],
      "backspace": "vim::DeleteLeft",
      "shift-delete": [
        "editor::DeleteToPreviousWordStart",
        {
          "ignore_newlines": false,
          "ignore_brackets": false
        }
      ],
      "=": "vim::Increment",
      "+": "vim::Increment",
      "-": "vim::Decrement",
      "/": "buffer_search::Deploy",
      "ctrl-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-a": "editor::SelectAll",
      "up": "editor::MoveLineUp",
      "down": "editor::MoveLineDown",
      "left": "editor::Outdent",
      "right": "editor::Indent",
      "s": null,
      "s p": [
        "workspace::SendKeystrokes",
        "y s i w )"
      ],
      "s b": [
        "workspace::SendKeystrokes",
        "y s i w ]"
      ],
      "s shift-b": [
        "workspace::SendKeystrokes",
        "y s i w }"
      ],
      "s t": [
        "workspace::SendKeystrokes",
        "y s i w >"
      ],
      "s q": [
        "workspace::SendKeystrokes",
        "y s i w \""
      ],
      "s )": [
        "workspace::SendKeystrokes",
        "y s i w )"
      ],
      "s ]": [
        "workspace::SendKeystrokes",
        "y s i w ]"
      ],
      "s }": [
        "workspace::SendKeystrokes",
        "y s i w }"
      ],
      "s >": [
        "workspace::SendKeystrokes",
        "y s i w >"
      ],
      "s \"": [
        "workspace::SendKeystrokes",
        "y s i w \""
      ],
      "s '": [
        "workspace::SendKeystrokes",
        "y s i w '"
      ],
      "s `": [
        "workspace::SendKeystrokes",
        "y s i w `"
      ],
      "s (": [
        "workspace::SendKeystrokes",
        "y s i w ("
      ],
      "s [": [
        "workspace::SendKeystrokes",
        "y s i w ["
      ],
      "s {": [
        "workspace::SendKeystrokes",
        "y s i w {"
      ],
      "s <": [
        "workspace::SendKeystrokes",
        "y s i w <"
      ],
      "~": [
        "workspace::SendKeystrokes",
        "~ j"
      ],
      "s *": [
        "workspace::SendKeystrokes",
        "y s i w *"
      ],
      "s _": [
        "workspace::SendKeystrokes",
        "y s i w _"
      ],
      "s $": [
        "workspace::SendKeystrokes",
        "y s i w $"
      ]
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "h": [
        "vim::PushObject",
        {
          "around": false
        }
      ],
      "shift-a": "vim::InsertBefore",
      "shift-h": "vim::InsertAfter",
      "shift-l": "vim::EndOfLineDownward",
      "c": "vim::VisualYank",
      "x": "vim::VisualDelete",
      "ctrl-alt-c": "vim::Substitute",
      "p": [
        "vim::Paste",
        {
          "preserve_clipboard": true
        }
      ],
      "ctrl-p": "vim::Paste",
      "ctrl-c": "vim::VisualYank",
      "ctrl-x": "vim::VisualDelete",
      "ctrl-f": "buffer_search::Deploy",
      "ctrl-a": "editor::SelectAll",
      "b": "vim::ToggleVisualBlock",
      "tab": "editor::Indent",
      "shift-tab": "editor::Outdent",
      "/": "buffer_search::Deploy",
      "ctrl-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "up": "editor::MoveLineUp",
      "down": "editor::MoveLineDown",
      "left": "editor::Outdent",
      "right": "editor::Indent",
      "v": "editor::SelectLargerSyntaxNode",
      "ctrl-alt-s": [
        "vim::PushAddSurrounds",
        {}
      ],
      "s": null,
      "s p": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s )"
      ],
      "s b": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s ]"
      ],
      "s shift-b": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s }"
      ],
      "s t": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s >"
      ],
      "s q": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s \""
      ],
      "s )": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s )"
      ],
      "s ]": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s ]"
      ],
      "s }": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s }"
      ],
      "s >": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s >"
      ],
      "s \"": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s \""
      ],
      "s '": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s '"
      ],
      "s `": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s `"
      ],
      "s (": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s ("
      ],
      "s [": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s ["
      ],
      "s {": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s {"
      ],
      "s <": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s <"
      ],
      "s *": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s *"
      ],
      "s _": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s _"
      ],
      "s $": [
        "workspace::SendKeystrokes",
        "ctrl-alt-s $"
      ],
      "~": "editor::ConvertToOppositeCase",
      "ctrl-v": "vim::Paste"
    }
  },
  {
    "context": "vim_mode == operator",
    "bindings": {
      "h": [
        "vim::PushObject",
        {
          "around": false
        }
      ],
      "k": null,
      "down": null
    }
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "c": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "x": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "r": "vim::CurrentLine"
    }
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "p": "vim::Parentheses",
      "shift-p": "vim::Paragraph",
      "b": "vim::SquareBrackets",
      "shift-b": "vim::CurlyBrackets",
      "t": "vim::AngleBrackets",
      "q": "vim::DoubleQuotes"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-u": "editor::Undo",
      "ctrl-a": "editor::SelectAll",
      "shift-delete": [
        "editor::DeleteToPreviousWordStart",
        {
          "ignore_newlines": false,
          "ignore_brackets": false
        }
      ],
      "ctrl-backspace": [
        "editor::DeleteToPreviousWordStart",
        {
          "ignore_newlines": false,
          "ignore_brackets": false
        }
      ],
      "ctrl-f": "buffer_search::Deploy",
      "escape": "vim::SwitchToNormalMode",
      "ctrl-v": "editor::Paste"
    }
  },
  {
    "context": "BufferSearchBar && !in_replace",
    "bindings": {
      "enter": "search::SelectNextMatch",
      "shift-enter": "search::SelectPreviousMatch"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "shift-alt-i": "editor::MoveLineUp",
      "shift-alt-k": "editor::MoveLineDown",
      "ctrl-h": "buffer_search::DeployReplace",
      "alt-.": "pane::TogglePinTab",
      "alt-[": [
        "workspace::SendKeystrokes",
        "5 ctrl-alt-shift-1"
      ],
      "alt-]": [
        "workspace::SendKeystrokes",
        "5 ctrl-alt-shift-2"
      ],
      "alt-{": [
        "workspace::SendKeystrokes",
        "2 ctrl-alt-shift-4"
      ],
      "alt-}": [
        "workspace::SendKeystrokes",
        "2 ctrl-alt-shift-3"
      ],
      "ctrl-alt-shift-1": "vim::ResizePaneLeft",
      "ctrl-alt-shift-2": "vim::ResizePaneRight",
      "ctrl-alt-shift-3": "vim::ResizePaneUp",
      "ctrl-alt-shift-4": "vim::ResizePaneDown",
      "ctrl-alt-up": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "up"
        }
      ],
      "ctrl-alt-down": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "down"
        }
      ],
      "ctrl-alt-left": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "left"
        }
      ],
      "ctrl-alt-right": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "right"
        }
      ],
      "ctrl-.": "editor::Hover",
    }
  },
  {
    "context": "((ProjectPanel || OutlinePanel) && not_editing) || (GitPanel && ChangesList)",
    "bindings": {
      "i": "menu::SelectPrevious",
      "k": "menu::SelectNext",
      "shift-t": "menu::SelectFirst",
      "shift-b": "menu::SelectLast"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "j": "project_panel::CollapseSelectedEntry",
      "l": "project_panel::ExpandSelectedEntry",
      "[": "project_panel::CollapseSelectedEntry",
      "]": "project_panel::ExpandSelectedEntry",
      "{": "project_panel::CollapseAllEntries",
      "}": "project_panel::ExpandAllEntries",
      "n": "project_panel::NewFile",
      "N": "project_panel::NewDirectory",
      "r": "project_panel::Rename"
    },
    "unbind": {
      "shift-r": "project_panel::Rename"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "j": "outline_panel::CollapseSelectedEntry",
      "[": "outline_panel::CollapseSelectedEntry",
      "]": "outline_panel::ExpandSelectedEntry",
      "{": "outline_panel::CollapseAllEntries",
      "}": "outline_panel::ExpandAllEntries",
      "l": "outline_panel::ExpandSelectedEntry"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-n": "workspace::NewTerminal",
      "alt-q": "pane::CloseActiveItem"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "alt-j": "git_panel::ActivateChangesTab",
      "alt-l": "git_panel::ActivateHistoryTab",
      "ctrl-up": "git::Push",
      "ctrl-down": "git::Pull"
    }
  },
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "shift-t": "git_panel::FirstEntry",
      "shift-b": "git_panel::LastEntry",
      "j": null,
      "l": null,
      "enter": "menu::SecondaryConfirm"
    }
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "alt-i": "menu::SelectPrevious",
      "alt-k": "menu::SelectNext",
      "alt-q": "tab_switcher::CloseSelectedItem"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-e": "editor::RevealInFileManager",
    }
  },
  {
    // normal mode only -- unscoped, these eat [ ] { } while typing
    "context": "Editor && mode == full && vim_mode == normal",
    "bindings": {
      "[": "editor::Fold",
      "]": "editor::UnfoldLines",
      "{": "editor::FoldAll",
      "}": "editor::UnfoldAll",
    }
  },
  {
    "context": "Editor && extension == md",
    "bindings": {
      "alt-v": "markdown::OpenPreviewToTheSide"
    }
  },
  {
    "context": "!SettingsWindow",
    "bindings": {
      "alt-,": "zed::OpenSettings"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "super-n": "workspace::NewWindow"
    }
  },
  {
    "context": "MarkdownPreview",
    "bindings": {
      "i": "markdown::ScrollUp",
      "k": "markdown::ScrollDown",
      "T": "markdown::ScrollToTop",
      "B": "markdown::ScrollToBottom",
    },
  },
  {
    "context": "Editor && multiple_selections",
    "bindings": {
      "enter": ["editor::SelectNext", { "replace_newest": true }],
      "shift-enter": ["editor::SelectPrevious", { "replace_newest": true }],
      "shift-n": "editor::UndoSelection"
    }
  },
]
