<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "../fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family">
      <string>Monofoki Nerd Font</string>
    </test>
    <edit name="family" mode="append_last">
      <string>monospace</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend" binding="strong">
      <string>Monofoki Nerd Font</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family">
      <string>Twemoji</string>
    </test>
    <edit name="family" mode="append_last">
      <string>emoji</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family">
      <string>emoji</string>
    </test>
    <edit name="family" mode="prepend">
      <string>Twemoji</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family">
      <string>Akkurat</string>
    </test>
    <edit name="family" mode="append_last">
      <string>sans-serif</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family">
      <string>sans-serif</string>
    </test>
    <edit name="family" mode="prepend">
      <string>Akkurat</string>
    </edit>
  </match>
  <match target="pattern">
    <test name="family"><string>Monofoki Nerd Font</string></test>
    <edit name="family" mode="append" binding="strong"><string>Noto Sans Symbols 2</string></edit>
  </match>
</fontconfig>
