
[global]
  origin = top-right
  offset = 15x15
  width = (0, 250)

  notification_limit = 1
  indicate_hidden = no

  padding = 14
  horizontal_padding = 16
  text_icon_padding = 12
  gap_size = 10

  frame_width = 1
  frame_color = "#656580E6"
  corner_radius = 8

  font = sans-serif 10
  line_height = 2

  idle_threshold = 60
  show_age_threshold = -1

  enable_recursive_icon_lookup = true
  icon_theme = Custom
  min_icon_size = 32
  max_icon_size = 32


  background = "#2A2A37CC"
  foreground = "#E6E0C2"

[demote_blueman]
  appname = "blueman"
  urgency = low

[urgency_low]
  # script = low.sound
  timeout = 3

[urgency_normal]
  script = normal.sound
  timeout = 10

[urgency_critical]
  background = "#3D2727CC"
  frame_color = "#E67B7F"
  timeout = 0
  script = critical.sound
