
[global]
  origin = top-right
  offset = 15x15
  width = (0, 250)

  notification_limit = 3
  indicate_hidden = yes

  padding = 10
  horizontal_padding = 12
  text_icon_padding = 12
  gap_size = 10

  frame_width = 1
  frame_color = "#F7C3A1"
  corner_radius = 8

  font = sans-serif 10
  line_height = 2

  idle_threshold = 60
  show_age_threshold = -1

  enable_recursive_icon_lookup = true
  icon_theme = Custom
  min_icon_size = 32
  max_icon_size = 32


  background = "#FDF6E3"
  foreground = "#49473E"

[urgency_low]
  background = "#2A2A37"
  foreground = "#E6E0C2"
  frame_color = "#4E4E62"
  script = low.sound
  timeout = 3

[urgency_normal]
  script = normal.sound
  timeout = 10

[urgency_critical]
  frame_color = "#FF7800"
  timeout = 0
  default_icon = software-update-urgent-symbolic
  script = critical.sound
