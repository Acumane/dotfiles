PATH=/sbin:/bin:/usr/sbin:/usr/bin
SHELL=/bin/bash

# ╭──────────────── minute (0 - 59)
# │  ╭───────────── hour (0 - 23)
# │  │  ╭────────── day of month (1 - 31)
# │  │  │  ╭─────── month (1 - 12) OR jan, feb, mar...
# │  │  │  │  ╭──── day of week (0 - 6) (Sunday=0 or 7) OR sun, mon, tue...
# │  │  │  │  │
# *  *  *  *  *     user    command
  30 *  *  *  *     bren    play -v 0.4 $HOME/audio/sounds/thirty.flac
  5  *  *  *  *     bren    liquidctl --match h80i set logo color blackout

  @hourly           bren    play -v 0.6 $HOME/audio/sounds/hour.flac
  @daily            bren    trash-empty 30
