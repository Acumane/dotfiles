# —— INIT ———————————————————————

autoload -Uz compinit
zstyle ':completion:*' menu yes select
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':zcomet:compinit' dump-file $ZDOTDIR/.dump
zstyle ':zcomet:compinit' arguments -i
zmodload zsh/complist
_comp_options+=(globdots)        # Include hidden files
zle_highlight=('paste:none')
autoload -Uz colors && colors    # Colors

source $ZDOTDIR/alias.zsh               # aliases
if [[ ! -f ${ZDOTDIR}/.zcomet/bin/zcomet.zsh ]]; then
  command git clone https://github.com/agkozak/zcomet.git ${ZDOTDIR:-${HOME}}/.zcomet/bin
fi
source $ZDOTDIR/.zcomet/bin/zcomet.zsh  # plugin manager
source $DOTS/zsh/zshenv                 # env vars (re-source)

[ -z "$DISPLAY" ] && exec Hyprland

# —— PROMPT —————————————————————

export VIRTUAL_ENV_DISABLE_PROMPT=1
setopt PROMPT_SUBST
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '  %F{15} %b%f'

venv_status() { [[ -n "$VIRTUAL_ENV" ]] && echo "%F{8}($(basename $VIRTUAL_ENV))%f " }

[[ $EUID -eq 0 ]] && PROMPT="%F{1}»%f " || PROMPT="%F{246}›%f "
RPROMPT='$(venv_status)%F{240}%1~%f${vcs_info_msg_0_}'

# —— EXTS ———————————————————————

load zsh-users/zsh-completions
load ohmyzsh plugins/dirhistory
load ohmyzsh plugins/sudo

eval "$(zoxide init zsh --cmd g)"
zcomet compinit

load RobSis/zsh-completion-generator
load Aloxaf/fzf-tab

# load marlonrichert/zsh-autocomplete
load zsh-users/zsh-autosuggestions
load zsh-users/zsh-syntax-highlighting
# load zdharma-continuum/fast-syntax-highlighting

# —— KEYS ———————————————————————

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey '^[' autosuggest-clear
# bindkey '^[[C' autosuggest-accept
bindkey '^[[1;5C' forward-word          # power-navigation
bindkey '^[[1;5D' backward-word
bindkey '^[[3;2~' backward-kill-word    # keyd: S-bs -> S-del (compatibility)
bindkey '^[^?' clear-screen             # clear everything but active
bindkey -s '^[s' '^Uscan^M'
bindkey '^[h' hist
bindkey '^[?' where
bindkey '^[f' files
bindkey '^[F' dirs
bindkey '^[m' men
bindkey '^[[3;3~' hunt
bindkey '^e'  gui
bindkey '^[e' gui
bindkey '^[E' fm
bindkey '^[v' _v
bindkey '^[t' t

# —— COMPLETIONS ————————————————

compdef diag=dmesg
# compdef sys=systemctl
# compdef snap=snapper
# compdef @=jj
# compdef vm=quickemu
# compdef spin=docker
# compdef key=keyd
# compdef tz=timedatectl
compdef net=nmcli
compdef hl=grep
compdef app=dnf

# —— OPTIONS ————————————————————

unsetopt BEEP
setopt AUTO_CD
setopt GLOB_DOTS
setopt NOMATCH
setopt MENU_COMPLETE
setopt EXTENDED_GLOB
setopt INTERACTIVE_COMMENTS
# setopt NO_NOTIFY NO_MONITOR
setopt APPEND_HISTORY

HISTFILE=$ZDOTDIR/.hist
HISTSIZE=50000
SAVEHIST=50000

setopt BANG_HIST                 # Treat the '!' character specially during expansion
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format
setopt INC_APPEND_HISTORY        # Write to the history file immediately, not when the shell exits
setopt SHARE_HISTORY             # Share history between all sessions
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded again
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in the history file
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry
setopt HIST_VERIFY               # Don't execute immediately upon history expansion
stty stop undef                  # Prevent C+s from freezing terminal
