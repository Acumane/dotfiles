/* Forked from https://github.com/lr-tech/rofi-themes-collection */

* {
	bg:       #282835;
	fg:       #40404B;
	box:      #3B3A43CC;	
	text:     #DDD8BB;
	title:    #979589;
	dim:      #4C4C50;
	bord:     #3F3F50;

	background-color:   transparent;
	text-color:         @text;

	margin:     0px;
	padding:    0px;
	spacing:    0px;
}

window {
	location:         center;
	width:            325;
	background-color: @bg;
	border-radius:    12px;
	border-color:     @bord;
	border:           1px;
}

mainbox {
	padding: 8px;
}

inputbar {
	background-color:   @box;
	border-radius:      6px;

	padding:    5px 6px;
	margin:     4px 8px;
	spacing:    8px;
	children:   [ prompt, entry ];
}

prompt {
	text-color:       @title;
	background-color: @dim;
	border-radius:    100px;

	padding: 2px 10.5px 2.5px 6px;
	margin: 0px 0px 2px;
	spacing: 8px;
}

entry {
	cursor-width: 1px;
	padding:      2.5px 0 0 1px;
}

textbox {
	padding: 8px 24px;
}

listview {
	margin:  8px 0 1px 0;
	lines:   4;
	columns: 2;
}

element {
	padding:       7px 8px 7px 12px;
	margin:        1px;
	spacing:       10px;
	border-radius: 6px;
}

element selected normal, element selected active {
	background-color: @fg;
}

element-icon {
	size:           1em;
	vertical-align: 0.5;
}

element-text {
	padding:    0 0 1px 0;
	text-color: inherit;
}
